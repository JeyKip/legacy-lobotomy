				{
					"name": "Reset Password Request",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code >= 400) {",
									"    console.error(\"An error occurred while requesting the password reset.\", pm.response);",
									"    return;",
									"}",
									"",
									"const mailpitWebUrl = pm.environment.get(\"MAILPIT_WEB_URL\");",
									"",
									"if (!mailpitWebUrl) {",
									"    console.error(\"MAILPIT_WEB_URL is not defined.\");",
									"    return;",
									"}",
									"",
									"pm.sendRequest(",
									"  {",
									"    url: `${mailpitWebUrl}/api/v1/message/latest`,",
									"    method: \"GET\",",
									"    header: {",
									"      Accept: \"application/json\"",
									"    }",
									"  },",
									"  function (err, res) {",
									"    if (err) {",
									"      console.error(\"Failed to fetch latest message:\", err);",
									"      return;",
									"    }",
									"",
									"    const json = res.json();",
									"    const htmlBody = json.HTML || \"\";",
									"",
									"    if (!htmlBody) {",
									"      console.error(\"No HTML body found in email\");",
									"      return;",
									"    }",
									"",
									"    // Regex to extract uid and token from the reset link",
									"    const regex =",
									"      /password-reset-confirm\\/([^\\/]+)\\/([^\\/]+)\\//;",
									"",
									"    const match = htmlBody.match(regex);",
									"",
									"    if (!match) {",
									"      console.error(\"Password reset link not found in email body\");",
									"      return;",
									"    }",
									"",
									"    const uid = match[1];",
									"    const token = match[2];",
									"",
									"    // Store in collection variables",
									"    pm.collectionVariables.set(\"reset_password_uid\", uid);",
									"    pm.collectionVariables.set(\"reset_password_token\", token);",
									"  }",
									");",
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"{{USER_EMAIL}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{BASE_URL}}/auth/password/reset/",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"auth",
								"password",
								"reset",
								""
							]
						}
					},
					"response": []
				},
				{
					"name": "Reset Password Confirm",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code >= 400) {",
									"    console.error(\"An error occurred while resetting the password.\", pm.response);",
									"    return;",
									"}",
									"",
									"pm.collectionVariables.unset(\"reset_password_uid\");",
									"pm.collectionVariables.unset(\"reset_password_token\");",
									"",
									"const currentPassword = pm.environment.get(\"USER_PASSWORD\");",
									"const resetPassword = pm.environment.get(\"USER_RESET_PASSWORD\");",
									"",
									"pm.environment.set(\"USER_PASSWORD\", resetPassword);",
									"pm.environment.set(\"USER_RESET_PASSWORD\", currentPassword);"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"new_password1\": \"{{USER_RESET_PASSWORD}}\",\n    \"new_password2\": \"{{USER_RESET_PASSWORD}}\",\n    \"uid\": \"{{reset_password_uid}}\",\n    \"token\": \"{{reset_password_token}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{BASE_URL}}/auth/password/reset/confirm/",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"auth",
